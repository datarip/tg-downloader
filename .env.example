# You don't have to write this by hand — the GUI's Settings and Channels tabs
# save straight into it (at ~/.tg_downloader/.env if there's no ./.env). This
# template is for setting things up without the GUI, or on a server.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored — never commit the real one. $TG_ENV_FILE (or the CLI's
# --env-file) overrides which file is used. A GUI save edits the file in place:
# your comments and unrelated variables are preserved.

# From https://my.telegram.org -> API development tools.
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Channels to scan. Comma-separated: a numeric id, an @username, or id=Title.
# A JSON list works too: [{"id": -1001234567890, "title": "Research Dumps"}]
TG_CHANNELS=-1001234567890=Research Dumps, @somegroup

# Optional — these fall back to the config.json / built-in defaults.
# TG_DOWNLOAD_DIR=~/Downloads/TG
# TG_EXTENSIONS=.zip, .tar.gz, .csv, .json
# TG_SCAN_LIMIT=0
