# Normalise line endings so a Windows checkout and a Linux checkout produce the
# same text files; the shell scripts and hooks below must keep LF.
* text=auto eol=lf

*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
.githooks/* text eol=lf

# Build outputs and artwork: never convert or diff as text.
*.png     binary
*.ico     binary
*.icns    binary
*.jpg     binary
*.dmg     binary
*.exe     binary
*.AppImage binary
*.tar.gz  binary
*.zip     binary
